{
  "name": "masalapos-licensing",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "d1_databases": [
    { "binding": "DB", "database_name": "masalapos-licensing", "database_id": "<set by wrangler d1 create>", "migrations_dir": "migrations" }
  ],
  // The MasalaPOS Portal web app: build it first (npm run build -w @masalapos/portal), which writes dist/portal. The Worker runs first on
  // every request, serves /portal pages itself (with security headers) and leaves /v1 and the webhook untouched.
  "assets": { "directory": "../portal/dist", "binding": "ASSETS", "run_worker_first": true },
  // period must be 10 or 60 seconds; namespace_id is a string holding a positive integer.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  "env": {
    "test": {
      "d1_databases": [
        { "binding": "DB", "database_name": "masalapos-licensing-test", "database_id": "<set by wrangler d1 create>", "migrations_dir": "migrations" }
      ],
      "ratelimits": [
        { "name": "LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
        { "name": "LOGIN_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}
