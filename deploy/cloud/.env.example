# Copy to .env on the server and chmod 600. Never commit populated secrets.
# Database passwords must use URL-safe characters (generated hex is suitable).
PORTAL_DOMAIN=portal.example.com
RELEASE_TAG=local
POSTGRES_PASSWORD=
CLOUD_APP_PASSWORD=
MAIL_PROVIDER=http
MAIL_DELIVERY_URL=
MAIL_DELIVERY_TOKEN=
AZURE_EMAIL_ENDPOINT=
AZURE_EMAIL_ACCESS_KEY=
AZURE_EMAIL_SENDER=
STORAGE_PROVIDER=s3
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional subscription integration; configure both together.
LICENSING_BASE_URL=
LICENSING_SERVICE_TOKEN=
# Supply the first operator email/password only for the bootstrap job.
# Remove them afterward. Bootstrap refuses to modify existing operators.
CLOUD_ADMIN_EMAIL=
CLOUD_ADMIN_PASSWORD=
# Required only when deploying compose.pos.yml; selects this single restaurant's owner.
HOSTED_POS_EMAIL=
