FROM node:24-bookworm-slim AS build
WORKDIR /source
COPY . .
RUN npm ci --ignore-scripts && npm run build -w @forkflow/ui && node tools/build-hosted-pos.mjs

FROM node:24-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
RUN npm init -y && npm install --omit=dev better-sqlite3@13.0.3 fastify@5.12.5 @fastify/static@10.1.3 @fastify/websocket@11.3.0 proper-lockfile@4.1.2 qrcode@1.5.4 zod@4.4.3
COPY --from=build /source/build/hosted-pos/server /app/server
COPY --from=build /source/apps/ui/dist /app/ui
RUN mkdir -p /data && chown node:node /data
USER node
EXPOSE 4100
CMD ["node", "server/main.mjs"]
