FROM node:24-bookworm-slim AS build
WORKDIR /source
COPY . .
ARG CLOUD_UI_BASE=/
RUN npm ci --ignore-scripts && npm run build -w @forkflow/cloud-ui -- --base ${CLOUD_UI_BASE}
FROM nginx:1.28-alpine
COPY deploy/cloud/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /source/apps/cloud-ui/dist /usr/share/nginx/html
EXPOSE 80
