{
  "name": "forkflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI-native restaurant POS — offline-first hybrid SQLite (terminal) + PostgreSQL (cloud).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck -w @forkflow/ui",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:ui": "npm run dev -w @forkflow/ui"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
