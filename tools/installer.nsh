; Generated by tools/build-desktop.mjs: the path of this build's activation script, and whether the build activates online.
!include "${PROJECT_DIR}\build\desktop\installer\installer-config.nsh"

!macro customInstall
  nsExec::ExecToLog 'netsh advfirewall firewall delete rule name="MasalaPOS LAN"'
  nsExec::ExecToLog 'netsh advfirewall firewall add rule name="MasalaPOS LAN" dir=in action=allow program="$INSTDIR\MasalaPOS.exe" protocol=TCP localport=4100 profile=private remoteip=localsubnet enable=yes'
  Pop $0
  ${If} $0 != 0
    MessageBox MB_OK|MB_ICONEXCLAMATION "MasalaPOS was installed, but Windows could not add the LAN firewall rule. Billing on this PC will work. Ask your administrator to allow MasalaPOS on private networks for other counters."
  ${EndIf}
!macroend

!macro customUnInstall
  nsExec::ExecToLog 'netsh advfirewall firewall delete rule name="MasalaPOS LAN"'
!macroend

; Activation: the Customer ID and Order ID from the setup card are required, and this computer is activated before anything is
; installed. Automatic updates skip the page (the computer is already activated). The app adopts what the script leaves in
; %ProgramData%\MasalaPOS\activation.json at first start; Setup and Settings > Plan and devices remain the fallback.
!ifdef MASALAPOS_ONLINE_ACTIVATION
!macro customPageAfterChangeDir
  !include nsDialogs.nsh
  Var ActivationCustomerField
  Var ActivationOrderField
  Var ActivationCustomer
  Var ActivationOrder

  Page custom ActivationPageShow ActivationPageLeave

  Function ActivationPageShow
    ${If} ${isUpdated}
      Abort
    ${EndIf}
    !insertmacro MUI_HEADER_TEXT "Activate MasalaPOS" "Enter the Customer ID and Order ID from your MasalaPOS setup card."
    nsDialogs::Create 1018
    Pop $0
    ${If} $0 == error
      Abort
    ${EndIf}
    ${NSD_CreateLabel} 0 0 100% 20u "This computer must be connected to the internet. Setup activates MasalaPOS before it installs; this takes a few seconds after you click Next."
    ${NSD_CreateLabel} 0 28u 100% 10u "Customer ID (for example FC-7K3M-9QX)"
    ${NSD_CreateText} 0 40u 50% 13u "$ActivationCustomer"
    Pop $ActivationCustomerField
    ${NSD_CreateLabel} 0 62u 100% 10u "Order ID (for example FO-2D8H-4MA)"
    ${NSD_CreateText} 0 74u 50% 13u "$ActivationOrder"
    Pop $ActivationOrderField
    ${NSD_CreateLabel} 0 98u 100% 20u "No setup card? Contact MasalaPOS. For a computer that can't go online, ask MasalaPOS for an offline licence file."
    ${NSD_SetFocus} $ActivationCustomerField
    nsDialogs::Show
  FunctionEnd

  Function ActivationPageLeave
    ${NSD_GetText} $ActivationCustomerField $ActivationCustomer
    ${NSD_GetText} $ActivationOrderField $ActivationOrder
    ${If} $ActivationCustomer == ""
    ${OrIf} $ActivationOrder == ""
      MessageBox MB_OK|MB_ICONEXCLAMATION "Enter both the Customer ID and the Order ID from your MasalaPOS setup card."
      Abort
    ${EndIf}
    InitPluginsDir
    File "/oname=$PLUGINSDIR\activate.ps1" "${MASALAPOS_ACTIVATION_SCRIPT}"
    ; The codes go through a file, never the command line, so nothing typed here can change the command.
    FileOpen $0 "$PLUGINSDIR\activation-ids.txt" w
    FileWrite $0 "$ActivationCustomer$\r$\n$ActivationOrder$\r$\n"
    FileClose $0
    GetDlgItem $1 $HWNDPARENT 1
    EnableWindow $1 0
    nsExec::ExecToStack '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\activate.ps1" -Ids "$PLUGINSDIR\activation-ids.txt"'
    Pop $2
    Pop $3
    EnableWindow $1 1
    Delete "$PLUGINSDIR\activation-ids.txt"
    ${If} $2 != 0
      ${If} $3 == ""
        StrCpy $3 "Setup couldn't activate MasalaPOS. Check the internet connection and try again."
      ${EndIf}
      MessageBox MB_OK|MB_ICONEXCLAMATION "$3"
      Abort
    ${EndIf}
  FunctionEnd
!macroend
!endif
