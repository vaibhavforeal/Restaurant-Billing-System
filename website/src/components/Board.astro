---
import { board } from '../data/content';

// A decorative pattern of squares for the QR tile (not a scannable code).
const N = 13;
const finder = (x: number, y: number) =>
  (x < 4 && y < 4) || (x > N - 5 && y < 4) || (x < 4 && y > N - 5);
const cells: { x: number; y: number }[] = [];
let seed = 7;
for (let y = 0; y < N; y++) {
  for (let x = 0; x < N; x++) {
    seed = (seed * 9301 + 49297) % 233280;
    const on = finder(x, y) ? ((x % 3 !== 1 || y % 3 !== 1) && ((x === 0 || x === 3 || x === N - 1 || x === N - 4 || y === 0 || y === 3 || y === N - 1 || y === N - 4) || (x % 3 === 1 && y % 3 === 1))) : seed / 233280 > 0.52;
    if (on) cells.push({ x, y });
  }
}
const tone: Record<string, string> = {
  qr: 'o', split: 't', credit: 'y', gst: 's', low: 'd', loyal: 'p', backup: 'l',
};
---

<section class="board wrap" aria-labelledby="board-title">
  <div class="tiles">
    <div class="tile tile--head">
      <h2 id="board-title" class="head" data-reveal>{board.heading}</h2>
    </div>
    {board.tiles.map((t, i) => (
      <div class={`tile tile--${t.id} tone-${tone[t.id]}`} data-reveal style={`--i:${i % 3}`}>
        <div class="el" data-ui aria-hidden="true">
          {t.id === 'qr' && (
            <svg viewBox={`0 0 ${N} ${N}`} shape-rendering="crispEdges">
              <rect width={N} height={N} fill="#fff" />
              {cells.map((c) => <rect x={c.x} y={c.y} width="1" height="1" fill="#1c1714" />)}
            </svg>
          )}
          {t.id === 'split' && (
            <div class="chips"><span class="chip">Cash ₹140</span><span class="chip chip--o">UPI ₹500</span><span class="chip">Card ₹200</span></div>
          )}
          {t.id === 'credit' && <div class="chips"><span class="chip chip--d">Refunded</span><span class="chip">−₹280</span></div>}
          {t.id === 'gst' && <div class="chips chips--row"><span class="cap">GSTR-1</span><span class="cap">3B</span></div>}
          {t.id === 'low' && <div class="chips"><span class="chip chip--d">Low</span><span class="chip">3 L</span></div>}
          {t.id === 'loyal' && <div class="discs"><span>AR</span><span>MK</span><span>SP</span></div>}
          {t.id === 'backup' && <div class="chips"><span class="chip chip--o">Backed up</span><span class="chip">02:00</span></div>}
        </div>
        <div class="cap-text">
          <h3>{t.name}</h3>
          <p>{t.line}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style is:global>
  .board { padding-top: var(--gap-section); }
  .tiles { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: 104px; gap: 8px; }
  .tile { position: relative; overflow: hidden; border-radius: var(--r); font-family: var(--display); font-size: 14px; }
  .tile--head { grid-column: 1 / 7; grid-row: 1 / 3; border-radius: 0; display: flex; align-items: flex-start; }
  .tile--head .head { font-size: clamp(36px, 4vw, 60px); max-width: 9em; }
  .tile--qr { grid-column: 7 / 13; grid-row: 1 / 5; }
  .tile--split { grid-column: 1 / 4; grid-row: 3 / 5; }
  .tile--credit { grid-column: 4 / 7; grid-row: 3 / 5; }
  .tile--gst { grid-column: 1 / 4; grid-row: 5 / 7; }
  .tile--low { grid-column: 4 / 7; grid-row: 5 / 7; }
  .tile--loyal { grid-column: 7 / 10; grid-row: 5 / 7; }
  .tile--backup { grid-column: 10 / 13; grid-row: 5 / 7; }
  .tone-o { background: var(--accent); color: var(--ink); }
  .tone-t { background: var(--tawa); color: #fff; }
  .tone-y { background: var(--turmeric); color: var(--ink); }
  .tone-s { background: var(--sand); color: var(--ink); }
  .tone-d { background: var(--deep); color: #fff; }
  .tone-p { background: #ffd89a; color: var(--ink); }
  .tone-l { background: #ffb35c; color: var(--ink); }
  .cap-text { position: absolute; left: 20px; bottom: 18px; right: 20px; z-index: 2; }
  .cap-text h3 { font-size: 18px; font-weight: 600; line-height: 1.2; margin: 0 0 4px; }
  .cap-text p { font-family: var(--text); font-size: 15px; line-height: 1.3; margin: 0; max-width: 24em; }
  .tile .el[data-ui] { background: none; border-radius: 0; overflow: visible; color: inherit; font-family: var(--display); }
  .el { position: absolute; font-size: 300%; right: 4%; top: 10%; line-height: 1; pointer-events: none; transition: transform 0.6s var(--ease); }
  .tile:hover .el { transform: translate(-6px, 4px) scale(1.03); }
  .tile .tile--qr .el, .tile--qr .el[data-ui] { font-size: 100%; right: 28px; top: 28px; width: 250px; border-radius: 28px; overflow: hidden; }
  .chips { display: flex; flex-direction: column; align-items: flex-end; gap: 0.25em; }
  .chips--row { flex-direction: row; gap: 0.3em; }
  .chip { display: inline-block; padding: 0.15em 0.6em; border-radius: 999px; background: rgba(255, 255, 255, 0.92); color: var(--ink); font-weight: 700; font-size: 0.55em; white-space: nowrap; }
  .chip--o { background: var(--accent); }
  .chip--d { background: var(--deep); color: #fff; }
  .cap { display: inline-block; padding: 0.1em 0.45em; border-radius: 0.28em; background: #fff; color: var(--ink); font-weight: 700; font-size: 0.55em; white-space: nowrap; }
  .discs { display: flex; padding-right: 0.2em; }
  .discs span { width: 2.2em; height: 2.2em; flex: none; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 0.5em; background: var(--tawa); color: #fff; margin-left: -0.35em; }
  .discs span:nth-child(2) { background: var(--accent); color: var(--ink); }
  .discs span:nth-child(3) { background: #fff; color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .tile:hover .el { transform: none; } }
  @media (max-width: 800px) {
    .chip, .cap { font-size: 0.4em; }
    .discs span { font-size: 0.4em; }
    .tiles { grid-template-columns: 1fr 1fr; grid-auto-rows: min(30vw, 150px); gap: 6px; }
    .tile--head, .tile--qr, .tile--split, .tile--credit, .tile--gst, .tile--low, .tile--loyal, .tile--backup { grid-column: auto; grid-row: auto; }
    .tile--head { grid-column: 1 / 3; grid-row: span 2; }
    .tile--head .head { font-size: 9vw; }
    .tile--qr { grid-column: 1 / 3; grid-row: span 3; }
    .tile--split, .tile--credit, .tile--gst, .tile--low, .tile--loyal, .tile--backup { grid-row: span 2; }
    .tile--qr .el[data-ui] { width: 52vw; right: 5vw; top: 5vw; }
    .cap-text { left: 14px; right: 14px; bottom: 12px; }
    .cap-text h3 { font-size: 16px; }
    .cap-text p { font-size: 14px; }
  }
</style>
