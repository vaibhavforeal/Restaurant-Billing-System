---
import Screen from './Screen.astro';
import { waLink } from '../config';
const demo = waLink('Hi, I would like a demo of MasalaPOS.');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__text">
    <h1 id="hero-title" class="display hero__title">Every bill,<br />GST-ready.</h1>
    <p class="hero__lead lead" data-reveal style="--i:1">MasalaPOS is Windows billing software for Indian restaurants. It runs billing, tables, the kitchen and stock from one restaurant PC, and keeps working when the internet drops.</p>
    <div class="hero__actions" data-reveal style="--i:2">
      <a class="btn" href={demo}>Book a demo</a>
      <a class="textlink" href="#modules">See what it does</a>
    </div>
  </div>
  <div class="hero__stage" aria-hidden="false">
    <div class="hero__disc" aria-hidden="true"></div>
    <div class="hero__screen"><Screen kind="bill" /></div>
  </div>
</section>

<style is:global>
  .hero { position: relative; min-height: max(100svh, 640px); overflow: hidden; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); align-items: center; padding: 110px var(--m) 56px; }
  .hero__text { position: relative; z-index: 2; }
  .hero__title { font-size: var(--step-hero); text-transform: uppercase; }
  .hero__lead { margin-top: 36px; max-width: 30em; font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3rem); line-height: 1.45; }
  .hero__actions { margin-top: 32px; display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
  .hero__stage { position: relative; align-self: stretch; display: grid; place-items: center; }
  .hero__disc { position: absolute; width: max(100svh, 760px); aspect-ratio: 1; border-radius: 50%; background: var(--accent); left: 50%; top: 50%; transform: translate(-42%, -48%); z-index: 0; }
  .hero__screen { position: relative; z-index: 1; width: min(100%, 560px); font-size: clamp(12px, 0.95vw, 15px); }
  .hero__screen [data-ui] { font-size: clamp(13px, 1vw, 15px); }

  .js .hero__screen { animation: shutter 1.1s var(--ease) 0.15s both; }
  .js .hero__screen [data-ui] { animation: settle 1.4s var(--ease) 0.15s both; }
  @keyframes shutter { from { clip-path: inset(0 0 0 100% round 1.4em); } to { clip-path: inset(0 0 0 0 round 1.4em); } }
  @keyframes settle { from { transform: scale(1.12); } to { transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) {
    .js .hero__screen, .js .hero__screen [data-ui] { animation: none; }
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; align-items: start; padding-top: 96px; padding-bottom: 0; min-height: 0; }
    .hero__title { font-size: 11.5vw; }
    .hero__lead { margin-top: 24px; font-size: 1.125rem; }
    .hero__stage { margin-top: 36px; min-height: 0; align-items: center; padding: 12vw 0; }
    .hero__disc { width: 130vw; left: 50%; top: 50%; transform: translate(-50%, -50%); }
    .hero__screen { width: 92%; margin-inline: auto; }
  }
</style>
